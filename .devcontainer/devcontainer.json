{
    "name": "Webserv Environment",
    "dockerComposeFile": "../docker-compose.yml",
    "service": "webserv",
    "workspaceFolder": "/app",
    
    // This creates the container but prevents it from shutting down immediately
    // so you can keep working in it.
    "shutdownAction": "stopCompose",

    // This automatically installs the C++ extension INSIDE the container
    // so IntelliSense works with the Linux headers.
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools",
                "ms-vscode.cmake-tools" 
            ]
        }
    },

    // user usually defaults to root in this setup, which is fine for 42 projects
    "remoteUser": "root"
}